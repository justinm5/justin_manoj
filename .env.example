# Copy to .env.local and fill in. Never commit .env.local.
# The same values go in your host's dashboard (Vercel > Settings > Environment Variables).

# --- Ask chatbot -----------------------------------------------------------
# Free key from https://console.groq.com. Without it the Ask page falls back to
# the on-device answering engine in src/lib/local-answer.ts.
GROQ_API_KEY=

# --- Spotify footer widget -------------------------------------------------
# From https://developer.spotify.com/dashboard.
# Add http://127.0.0.1:8888/callback as a redirect URI in your app settings —
# Spotify rejects http://localhost, and https://localhost needs a certificate.
# Then run `node scripts/get-spotify-token.mjs` to fill all four of these in.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
SPOTIFY_REFRESH_TOKEN=
